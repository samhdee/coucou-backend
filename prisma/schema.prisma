generator client {
    provider     = "prisma-client"
    output       = "../generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "mysql"
}

enum TimerType {
    WORK
    PAUSE
}

model Timer {
    id        String    @id @default(cuid())
    uuid      String
    endTime   DateTime
    type      TimerType @default(WORK)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
}

model PastTimers {
    id        String   @id @default(cuid())
    duration  Int
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
