generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "mysql"
}

enum TimerStatus {
    RUNNING
    PAUSED
    STOPPED
}

enum TimerType {
    WORK
    PAUSE
}

model Timer {
    id        String      @id @default(cuid())
    uuid      String
    status    TimerStatus @default(RUNNING)
    endTime   DateTime
    type      TimerType   @default(WORK)
    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt
}

model PastTimers {
    id        String   @id @default(cuid())
    duration  Int
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
